# ==============================================================================
# APEX ALPHA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# 복사하여 .env 파일을 생성하고 실제 거래소 API Key를 입력하세요. (절대 Git 커밋 금지)
# ==============================================================================

# Runtime Environment (development | paper | live)
APEX_ENV=paper
RUST_LOG=info,apex_stat_arb_production=debug

# Binance Futures API Keys (필수: IP Whitelist 등록, 출금 권한 절대 비활성화)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Hyperliquid L1/L2 Sub-Account (옵션)
HYPERLIQUID_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
HYPERLIQUID_PRIVATE_KEY=your_hyperliquid_private_key_here

# Telegram Alert Bot (PnL 및 이상 거래 알림)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
